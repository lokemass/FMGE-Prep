# GEMINI_API_KEY: Required for Gemini AI API calls (server-side & seeding scripts).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/fmge_prep)
# Optional for preview: when omitted, the server boots in Preview Mode with 30 curated sample MCQs in memory.
MONGODB_URI=""

# ADMIN_PASSCODE: Admin password required to unlock /admin/flagged and /admin/stats.
# Optional: if unset, /admin/flagged offers a one-time first-run password setup form.
ADMIN_PASSCODE=""

# ADMIN_EMAILS: Optional comma-separated list of signed-in user emails granted admin access.
ADMIN_EMAILS=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
